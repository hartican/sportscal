SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only. Required by signup metadata seeding and guest Web Push APIs.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Server-only modern `sb_secret_...` key. Required only for proxied anonymous
# Auth signup/refresh requests so Supabase can trust `Sb-Forwarded-For` and
# rate-limit each guest's real Vercel-provided client IP.
SUPABASE_SECRET_KEY=sb_secret_your_server_key
# Server-only HMAC secret for unlisted guest room capability links. Generate at
# least 32 random bytes; never expose it to browser code or log complete links.
CHAT_GUEST_LINK_SECRET=your_random_32_byte_or_longer_secret
# Generate as one VAPID keypair; never expose the private key to browser code.
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=https://nothingsport.vercel.app/
# Strong random bearer secret supplied by Vercel to the scheduled dispatch call.
CRON_SECRET=your_random_cron_secret
# Optional. Without this, the no-key geocoder plus built-in common locations is used.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Comma-separated exact origins accepted for password-recovery callbacks.
# Production is always allowlisted; add local and approved preview origins here.
AUTH_RECOVERY_ORIGINS=http://localhost:3000,https://your-preview.vercel.app
