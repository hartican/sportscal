{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsports.local/schemas/preference-graph.schema.json",
  "title": "nothingsport profile preference graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "updatedAt",
    "domainPreferences",
    "competitionPreferences",
    "entityFollows",
    "viewing",
    "learning"
  ],
  "properties": {
    "schemaVersion": { "const": "preference-graph.v6" },
    "profileId": { "type": "string", "pattern": "^profile:" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "domainPreferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/domainPreference" }
    },
    "competitionPreferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/competitionPreference" }
    },
    "entityFollows": {
      "type": "array",
      "items": { "$ref": "#/$defs/entityFollow" }
    },
    "viewing": { "$ref": "#/$defs/viewingPreference" },
    "learning": { "$ref": "#/$defs/learningPreference" }
  },
  "$defs": {
    "domainPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "sportDomainId",
        "taxonomyNodeId",
        "enabled",
        "templateId",
        "includeAllFixtures",
        "includeMajorEvents",
        "includeFollowedTeams",
        "narrativeVisibility",
        "narrativeIntensity",
        "mustWatchSensitivity",
        "reminderDefault",
        "scopedCompetitionIds",
        "scopedTaxonomyNodeIds"
      ],
      "properties": {
        "profileId": { "type": "string", "pattern": "^profile:" },
        "sportDomainId": { "type": "string", "minLength": 3 },
        "taxonomyNodeId": { "type": ["string", "null"], "pattern": "^(sport|discipline|competition|event-series):" },
        "enabled": { "type": "boolean" },
        "templateId": { "enum": ["template:froth", "template:like", "template:casual", "template:custom"] },
        "includeAllFixtures": { "type": "boolean" },
        "includeMajorEvents": { "type": "boolean" },
        "includeFollowedTeams": { "type": "boolean" },
        "narrativeVisibility": { "enum": ["off", "importantOnly", "allEligible"] },
        "narrativeIntensity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "mustWatchSensitivity": { "enum": ["low", "medium", "high"] },
        "reminderDefault": { "enum": ["off", "importantOnly", "allFollowed"] },
        "scopedCompetitionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scopedTaxonomyNodeIds": { "type": "array", "items": { "type": "string", "pattern": "^(sport|discipline|competition|event-series):" }, "uniqueItems": true }
      }
    },
    "competitionPreference": {
      "type": "object",
      "required": ["profileId", "competitionId", "taxonomyCompetitionId", "enabled", "templateInheritedFromDomain"],
      "properties": {
        "profileId": { "type": "string", "pattern": "^profile:" },
        "competitionId": { "type": "string", "minLength": 3 },
        "taxonomyCompetitionId": { "type": ["string", "null"], "pattern": "^(sport|discipline|competition|event-series):" },
        "enabled": { "type": "boolean" },
        "templateInheritedFromDomain": { "type": "boolean" },
        "includeAllFixtures": { "type": "boolean" },
        "includeMajorEvents": { "type": "boolean" }
      }
    },
    "entityFollow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "participantId", "followLevel"],
      "properties": {
        "profileId": { "type": "string", "pattern": "^profile:" },
        "participantId": { "type": "string", "minLength": 3 },
        "followLevel": { "enum": ["follow", "priority", "mute"] }
      }
    },
    "viewingPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "selectedBroadcasterIds",
        "excludedBroadcasterIds",
        "knownBroadcasterIds",
        "viewingWindowEnabled",
        "startHourLocal",
        "endHourLocal",
        "allowLateNightOverrides",
        "calendarSyncEnabled",
        "browserAlertsEnabled",
        "reminderLeadMinutes"
      ],
      "properties": {
        "profileId": { "type": "string", "pattern": "^profile:" },
        "selectedBroadcasterIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "excludedBroadcasterIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "knownBroadcasterIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "viewingWindowEnabled": { "type": "boolean" },
        "startHourLocal": { "type": "integer", "minimum": 0, "maximum": 23 },
        "endHourLocal": { "type": "integer", "minimum": 0, "maximum": 23 },
        "allowLateNightOverrides": { "type": "boolean" },
        "calendarSyncEnabled": { "type": "boolean" },
        "browserAlertsEnabled": { "type": "boolean" },
        "reminderLeadMinutes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 10080 }, "uniqueItems": true }
      }
    },
    "learningSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetType", "targetId", "value", "source", "recordedAt"],
      "properties": {
        "targetType": { "enum": ["sport", "competition", "team", "player", "event", "event_family"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "value": { "enum": [-1, 1] },
        "source": { "enum": ["calibration", "feed", "tune"] },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },
    "learningPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signals",
        "dislikeCount",
        "tuningPromptCount",
        "lastTunePromptDislikeCount",
        "calibrationSkippedTargetIds",
        "calibrationCompletedAt",
        "calibrationSkippedAt",
        "tuningInteractionCount",
        "tuningDomainIds",
        "completedTuningSessionCount",
        "lastTuningSessionCompletedAt",
        "meaningfulTuningAt",
        "meaningfulTuningDislikeCount",
        "negativeContextCounts"
      ],
      "properties": {
        "signals": { "type": "array", "maxItems": 120, "items": { "$ref": "#/$defs/learningSignal" } },
        "dislikeCount": { "type": "integer", "minimum": 0 },
        "tuningPromptCount": { "type": "integer", "minimum": 0 },
        "lastTunePromptDislikeCount": { "type": ["integer", "null"], "minimum": 0 },
        "calibrationSkippedTargetIds": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "calibrationCompletedAt": { "type": ["string", "null"], "format": "date-time" },
        "calibrationSkippedAt": { "type": ["string", "null"], "format": "date-time" },
        "tuningInteractionCount": { "type": "integer", "minimum": 0 },
        "tuningDomainIds": { "type": "array", "maxItems": 24, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "completedTuningSessionCount": { "type": "integer", "minimum": 0 },
        "lastTuningSessionCompletedAt": { "type": ["string", "null"], "format": "date-time" },
        "meaningfulTuningAt": { "type": ["string", "null"], "format": "date-time" },
        "meaningfulTuningDislikeCount": { "type": ["integer", "null"], "minimum": 0 },
        "negativeContextCounts": {
          "type": "object",
          "maxProperties": 120,
          "propertyNames": { "type": "string", "minLength": 3, "maxLength": 180 },
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 1000000 }
        }
      }
    }
  }
}
