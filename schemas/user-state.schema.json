{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsports.local/schemas/user-state.schema.json",
  "title": "nothingsport durable user state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "preferences",
    "eventUserState",
    "eventSpoilerState",
    "archivedEvents",
    "ratings"
  ],
  "properties": {
    "schemaVersion": { "const": "user-state.v2" },
    "profile": { "type": "object" },
    "preferences": { "type": "object" },
    "eventUserState": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/eventAction" }
    },
    "eventSpoilerState": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "archivedEvents": {
      "type": "array",
      "items": { "type": "object" }
    },
    "ratings": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 1,
        "maximum": 10
      }
    }
  },
  "$defs": {
    "eventAction": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actionKey": { "type": "string" },
        "canonicalEventId": { "type": "string" },
        "eventId": { "type": "string" },
        "startTime": { "type": "string" },
        "addedToFixtures": { "type": "boolean" },
        "addedToFixturesAt": { "type": ["string", "null"], "format": "date-time" },
        "addedFixture": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": true,
              "required": ["eventId", "majorEventParentId", "date", "time", "startTimeUtc"],
              "properties": {
                "eventId": { "type": "string", "minLength": 1 },
                "majorEventParentId": { "type": "string", "minLength": 1 },
                "date": { "type": "string", "format": "date" },
                "time": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
                "startTimeUtc": {
                  "anyOf": [
                    { "type": "null" },
                    { "type": "string", "format": "date-time" }
                  ]
                },
                "timePrecision": { "enum": ["exact", "session-start", "follows", "date-only", "unpublished"] },
                "sessionStartTimeUtc": {
                  "anyOf": [
                    { "type": "null" },
                    { "type": "string", "format": "date-time" }
                  ]
                },
                "sequenceInSession": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        "watchLater": { "type": "boolean" },
        "watched": { "type": "boolean" },
        "watchedAt": { "type": ["string", "null"], "format": "date-time" },
        "saved": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "dismissed": { "type": "boolean" },
        "dismissedAt": { "type": ["string", "null"], "format": "date-time" },
        "dismissalSource": { "enum": ["feed", "events", "hidden_restore", null] },
        "lastActionAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
