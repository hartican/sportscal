{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsports.local/schemas/sport-context.schema.json",
  "title": "nothingSports modular sport context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taxonomyVersion",
    "season",
    "generatedAt",
    "sources",
    "sportDomains",
    "competitionFamilies",
    "competitions",
    "participants",
    "ladderSnapshots",
    "eventParticipantScopes"
  ],
  "properties": {
    "schemaVersion": { "const": "sport-context.v1" },
    "taxonomyVersion": { "const": "sports-taxonomy.v1" },
    "season": { "type": "integer", "minimum": 2026 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/source" }
    },
    "sportDomains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sportDomain" }
    },
    "competitionFamilies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/competitionFamily" }
    },
    "competitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/competition" }
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/participant" }
    },
    "ladderSnapshots": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/standingsSnapshot" }
    },
    "jerseySnapshots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/jerseySnapshot" }
    },
    "eventParticipantScopes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/eventParticipantScope" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "sourceUrl", "sourceType", "checkedAt"],
      "properties": {
        "provider": { "type": "string", "minLength": 2 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "sourceType": { "const": "official" },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "sportDomain": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "slug", "name", "kind", "sortOrder", "isActive", "supportsLadders", "supportsTeams", "supportsCompetitors"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 2 },
        "kind": { "const": "sport" },
        "sortOrder": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "supportsLadders": { "type": "boolean" },
        "supportsTeams": { "type": "boolean" },
        "supportsCompetitors": { "type": "boolean" }
      }
    },
    "competitionFamily": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "sportDomainId", "slug", "name", "familyType", "sortOrder", "isActive"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sportDomainId": { "$ref": "#/$defs/id" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 2 },
        "familyType": { "enum": ["championship", "tour"] },
        "sortOrder": { "type": "integer" },
        "isActive": { "type": "boolean" }
      }
    },
    "competition": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "sportDomainId",
        "preferenceDomainId",
        "competitionFamilyId",
        "slug",
        "name",
        "competitionType",
        "seasonLabel",
        "supportsLadder",
        "supportsTeams",
        "supportsCompetitors",
        "standingsOnly",
        "standingsType",
        "defaultStandingsVisibility"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sportDomainId": { "$ref": "#/$defs/id" },
        "preferenceDomainId": { "$ref": "#/$defs/id" },
        "competitionFamilyId": { "$ref": "#/$defs/id" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 2 },
        "competitionType": { "enum": ["seasonChampionship", "seasonLeague", "ranking", "stageRace", "multiSportEvent"] },
        "seasonLabel": { "type": "string" },
        "supportsLadder": { "type": "boolean" },
        "supportsTeams": { "type": "boolean" },
        "supportsCompetitors": { "type": "boolean" },
        "standingsOnly": { "const": true },
        "standingsType": { "enum": ["drivers", "constructors", "singlesRanking", "stageJerseys", "conferenceStandings", "medalTable"] },
        "defaultStandingsVisibility": { "enum": ["summary", "full"] }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sportDomainId", "displayName", "canonicalName", "countryCode", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["team", "competitor"] },
        "sportDomainId": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 2 },
        "shortName": { "type": "string", "minLength": 2 },
        "canonicalName": { "type": "string", "minLength": 2 },
        "teamCode": { "type": "string", "minLength": 2 },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "metadata": {
          "type": "object",
          "required": ["active"],
          "properties": {
            "active": { "type": "boolean" },
            "teamParticipantId": { "$ref": "#/$defs/id" },
            "abbreviation": { "type": "string", "minLength": 3, "maxLength": 3 },
            "titleAliases": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 2 }
            }
          }
        }
      }
    },
    "standingsEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantId", "rank"],
      "properties": {
        "participantId": { "$ref": "#/$defs/id" },
        "rank": { "type": "integer", "minimum": 1 },
        "points": { "type": "number", "minimum": 0 },
        "played": { "type": "integer", "minimum": 0 },
        "won": { "type": "integer", "minimum": 0 },
        "lost": { "type": "integer", "minimum": 0 },
        "winPercentage": { "type": "number", "minimum": 0, "maximum": 1 },
        "gamesBehind": { "type": "number", "minimum": 0 },
        "gold": { "type": "integer", "minimum": 0 },
        "silver": { "type": "integer", "minimum": 0 },
        "bronze": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "teamParticipantId": { "$ref": "#/$defs/id" }
      }
    },
    "standingsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "competitionId", "seasonLabel", "roundLabel", "snapshotTimeUtc", "entries", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "competitionId": { "$ref": "#/$defs/id" },
        "seasonLabel": { "type": "string" },
        "roundLabel": { "type": "string" },
        "snapshotTimeUtc": { "type": "string", "format": "date-time" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/standingsEntry" }
        },
        "source": { "$ref": "#/$defs/source" },
        "metadata": { "type": "object" }
      }
    },
    "nullableParticipantId": {
      "anyOf": [
        { "$ref": "#/$defs/id" },
        { "type": "null" }
      ]
    },
    "jerseyState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yellowParticipantId", "polkadotParticipantId", "purpleParticipantId"],
      "properties": {
        "yellowParticipantId": { "$ref": "#/$defs/nullableParticipantId" },
        "polkadotParticipantId": { "$ref": "#/$defs/nullableParticipantId" },
        "purpleParticipantId": { "$ref": "#/$defs/nullableParticipantId" }
      }
    },
    "jerseySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "eventId",
        "stageNumber",
        "start",
        "close",
        "unavailableClassifications",
        "source"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "eventId": { "$ref": "#/$defs/id" },
        "stageNumber": { "type": "integer", "minimum": 1, "maximum": 21 },
        "start": { "$ref": "#/$defs/jerseyState" },
        "close": { "$ref": "#/$defs/jerseyState" },
        "unavailableClassifications": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["yellow", "polkadot", "purple"] }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "eventParticipantScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sportKey", "preferenceDomainId", "participantSportDomainId", "titlePattern"],
      "properties": {
        "sportKey": { "type": "string", "minLength": 2 },
        "preferenceDomainId": { "$ref": "#/$defs/id" },
        "participantSportDomainId": { "$ref": "#/$defs/id" },
        "titlePattern": { "type": "string", "minLength": 3 },
        "resolutionMode": { "enum": ["all-active", "title-match", "explicit"] },
        "participantIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
