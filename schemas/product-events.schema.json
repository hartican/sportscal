{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsport.vercel.app/schemas/product-events.schema.json",
  "title": "nothingSports product events batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "events"],
  "properties": {
    "schemaVersion": { "const": "product-events.v1" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clientEventId", "eventName", "occurredAt", "sessionId", "surface"],
        "properties": {
          "clientEventId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]+$" },
          "eventName": {
            "enum": ["opportunity_exposed", "fixture_check", "watch_decision", "swipe", "rating", "tune_prompt", "tune_session", "weekly_pulse"]
          },
          "occurredAt": { "type": "string", "format": "date-time", "maxLength": 40 },
          "sessionId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]+$" },
          "surface": {
            "enum": ["curated_feed", "round_summary", "sport_hub", "fixture_list", "event_card", "settings", "weekly_pulse", "onboarding", "calibration", "tune", "archive"]
          },
          "sport": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "competitionId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$" },
          "canonicalEventId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$" },
          "properties": { "type": "object", "maxProperties": 3 }
        }
      }
    }
  }
}
