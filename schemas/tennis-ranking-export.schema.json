{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsports.local/schemas/tennis-ranking-export.schema.json",
  "title": "nothingSport reviewed tennis ranking export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "tour", "rankingSnapshotDate", "extractedAt", "ingestionMode", "sourceUrl", "scope", "athletes"],
  "properties": {
    "schemaVersion": { "const": "tennis-ranking-export.v1" },
    "provider": { "type": "string", "minLength": 2 },
    "tour": { "enum": ["ATP", "WTA"] },
    "rankingSnapshotDate": { "type": "string", "format": "date" },
    "extractedAt": { "type": "string", "format": "date-time" },
    "publicationCheckedAt": { "type": "string", "format": "date-time" },
    "publicationUrl": { "type": "string", "format": "uri" },
    "sourceTrust": { "enum": ["verified", "unverified"] },
    "ingestionMode": { "enum": ["manual_reviewed_export", "licensed_api", "public_first_party"] },
    "sourceUrl": { "type": "string", "format": "uri" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topN", "nationalityCodes", "complete"],
      "properties": {
        "topN": { "type": "integer", "minimum": 50 },
        "nationalityCodes": { "type": "array", "contains": { "const": "AUS" }, "items": { "type": "string", "pattern": "^[A-Z]{3}$" } },
        "complete": { "const": true }
      }
    },
    "athletes": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "nationalityCode", "providerId", "rank", "selectionReasons"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "nationalityCode": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "points": { "type": "number", "minimum": 0 },
          "providerId": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "selectionReasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["top_50", "australian"] } }
        }
      }
    }
  }
}
