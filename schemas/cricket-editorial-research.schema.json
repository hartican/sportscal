{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsport.local/schemas/cricket-editorial-research.schema.json",
  "title": "Cricket editorial evidence ledger",
  "type": "object",
  "required": [
    "id",
    "title",
    "editorialPolicyVersion",
    "evidenceMode",
    "editorialPhase",
    "researchedAt",
    "validUntil",
    "sources",
    "sourceObservations",
    "facts",
    "paragraphClaims",
    "editorialReview",
    "researchUsage"
  ],
  "properties": {
    "editorialPolicyVersion": {
      "const": "cricket-editorial.v1"
    },
    "evidenceMode": {
      "enum": [
        "synthesis",
        "fact-brief",
        "withheld"
      ]
    },
    "editorialPhase": {
      "enum": [
        "preview",
        "ongoing",
        "recap"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "sourceObservations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "name",
          "publisher",
          "author",
          "originId",
          "sourceType",
          "reportingType",
          "publishedAt",
          "checkedAt",
          "accessible",
          "retrievedAt"
        ]
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claimId",
          "claimType",
          "statement",
          "dimension",
          "sourceIndexes",
          "support"
        ]
      }
    },
    "paragraphClaims": {
      "type": "object"
    },
    "editorialReview": {
      "type": "object",
      "required": [
        "verdict",
        "reviewedAt",
        "checks",
        "contentSha256",
        "draftPassId",
        "passId"
      ]
    },
    "researchUsage": {
      "type": "object",
      "required": [
        "searches",
        "articleReads",
        "drafts",
        "reviews",
        "corrections"
      ]
    }
  }
}
