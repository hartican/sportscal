{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsports.local/schemas/team-player-directory.schema.json",
  "title": "nothingsport Australian team and player directory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "seasonLabel", "generatedAt", "sources", "leagues", "teams", "players"],
  "properties": {
    "schemaVersion": { "enum": ["nrl-directory.v1", "afl-directory.v1"] },
    "seasonLabel": { "type": "string", "minLength": 4 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sources": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/source" } },
    "leagues": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/league" } },
    "teams": { "type": "array", "minItems": 17, "items": { "$ref": "#/$defs/team" } },
    "players": { "type": "array", "minItems": 30, "items": { "$ref": "#/$defs/player" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "url", "sourceType", "checkedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^source:(nrl|afl):" },
        "provider": { "type": "string", "minLength": 2 },
        "url": { "type": "string", "format": "uri" },
        "sourceType": { "const": "official" },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "league": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "displayName", "countryCode", "seasonLabel", "teamCount", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^competition:" },
        "key": { "enum": ["nrl", "afl"] },
        "displayName": { "type": "string", "minLength": 2 },
        "countryCode": { "const": "AU" },
        "seasonLabel": { "type": "string", "minLength": 4 },
        "teamCount": { "type": "integer", "minimum": 17, "maximum": 20 },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "leagueId", "displayName", "shortName", "aliases", "sourceRefs", "active"],
      "properties": {
        "id": { "type": "string", "pattern": "^team:(nrl|afl):" },
        "leagueId": { "type": "string", "pattern": "^competition:" },
        "displayName": { "type": "string", "minLength": 2 },
        "shortName": { "type": "string", "minLength": 2 },
        "aliases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
        "active": { "type": "boolean" }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "sortName", "currentTeamId", "leagueId", "position", "sourceUrl", "sourceRefs", "active"],
      "properties": {
        "id": { "type": "string", "pattern": "^competitor:(nrl|afl):" },
        "displayName": { "type": "string", "minLength": 2 },
        "sortName": { "type": "string", "minLength": 2 },
        "currentTeamId": { "type": "string", "pattern": "^team:(nrl|afl):" },
        "leagueId": { "type": "string", "pattern": "^competition:" },
        "position": { "type": "string", "minLength": 2 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "birthplace": { "type": "string", "minLength": 2 },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
        "active": { "type": "boolean" }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^source:(nrl|afl):" }
    }
  }
}
