{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsports.local/schemas/profile-storage.schema.json",
  "title": "nothingsport profile storage bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "preferences",
    "domainPreferences",
    "competitionPreferences",
    "entityFollows",
    "viewingPreference",
    "learningPreference",
    "ratings",
    "eventUserState",
    "eventSpoilerState",
    "archivedEvents"
  ],
  "properties": {
    "schemaVersion": { "const": 6 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "usernameLabel", "createdAt", "updatedAt", "schemaVersion", "onboardingCompleted", "timezone"],
      "properties": {
        "id": { "type": "string", "pattern": "^profile:" },
        "usernameLabel": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "schemaVersion": { "const": 6 },
        "onboardingCompleted": { "type": "boolean" },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "preferenceSync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer",
        "entries"
      ],
      "properties": {
        "writer": {
          "const": "owned-preference-intent.v1"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ownerId",
              "generation",
              "receiptId",
              "baseUpdatedAt",
              "basePreferences",
              "preferences"
            ],
            "properties": {
              "ownerId": {
                "type": "string",
                "minLength": 1
              },
              "generation": {
                "type": "integer",
                "minimum": 0
              },
              "receiptId": {
                "type": "string",
                "pattern": "^preference-edit:"
              },
              "baseUpdatedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "basePreferences": {
                "type": "object"
              },
              "preferences": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "preferences": { "type": ["object", "null"] },
    "domainPreferences": { "type": "array", "items": { "type": "object" } },
    "competitionPreferences": { "type": "array", "items": { "type": "object" } },
    "entityFollows": { "type": "array", "items": { "type": "object" } },
    "viewingPreference": { "type": ["object", "null"] },
    "learningPreference": { "type": ["object", "null"] },
    "ratings": { "type": "object" },
    "eventUserState": { "type": "object" },
    "eventSpoilerState": { "type": "object" },
    "archivedEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "profileId", "canonicalEventId", "archivedAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^archive:" },
          "profileId": { "type": "string", "pattern": "^profile:" },
          "canonicalEventId": { "type": "string", "minLength": 1 },
          "archivedFromCardId": { "type": "string" },
          "archivedAt": { "type": "string", "format": "date-time" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
