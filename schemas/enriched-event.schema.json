{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsports.local/schemas/enriched-event.schema.json",
  "title": "nothingsport enriched event",
  "type": "object",
  "required": [
    "schemaVersion",
    "rankingVersion",
    "canonicalEventId",
    "userInterestScore",
    "followBoost",
    "followContext",
    "broadcasterFitScore",
    "stakesScore",
    "australiaRelevanceScore",
    "availabilityScore",
    "timeWindowFitScore",
    "editorialBoost",
    "mustWatchScore",
    "intensity",
    "cardVariant",
    "premiumSurface",
    "editorialOverride"
  ],
  "properties": {
    "schemaVersion": { "const": "enriched-event.v2" },
    "rankingVersion": { "const": "premium-ranking.v1" },
    "canonicalEventId": { "type": "string", "minLength": 1 },
    "userInterestScore": { "type": "number", "minimum": 0, "maximum": 5 },
    "followBoost": { "type": "number", "minimum": 0, "maximum": 5 },
    "followContext": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participantId", "participantType", "displayName", "followLevel"],
        "properties": {
          "participantId": { "type": "string", "minLength": 1 },
          "participantType": { "enum": ["team", "competitor", "pair", "nationalSide", "unknown"] },
          "displayName": { "type": "string", "minLength": 1 },
          "followLevel": { "enum": ["follow", "priority"] }
        }
      }
    },
    "broadcasterFitScore": { "type": "number", "minimum": 0, "maximum": 5 },
    "stakesScore": { "type": "integer", "minimum": 1, "maximum": 5 },
    "australiaRelevanceScore": { "type": "number", "minimum": 0, "maximum": 5 },
    "availabilityScore": { "type": "number", "minimum": 0, "maximum": 5 },
    "timeWindowFitScore": { "type": "number", "minimum": 0, "maximum": 5 },
    "editorialBoost": { "type": "number", "minimum": 0, "maximum": 5 },
    "mustWatchScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "intensity": { "type": "integer", "minimum": 1, "maximum": 5 },
    "cardVariant": { "enum": ["plain", "compact", "standard", "marquee"] },
    "premiumSurface": { "enum": ["homeMustWatch", "topStorylines", "sportFeed"] },
    "editorialOverride": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewedAt", "reviewedBy", "note"],
          "properties": {
            "reviewedAt": { "type": "string", "format": "date-time" },
            "reviewedBy": { "type": "string", "minLength": 1 },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "storyline": {
      "type": "object",
      "properties": {
        "archetype": { "enum": ["monster", "ragsToRiches", "quest", "voyageReturn", "rivalry", "rebirth", "comedy"] },
        "visibleLabel": { "enum": ["Top pick", "Must Watch", "Rivalry", "Record Chase", "Title Decider", "Upset Watch"] },
        "stakes": { "enum": ["low", "medium", "high", "critical"] },
        "arcStage": { "enum": ["inciting", "rising", "climax", "resolution"] },
        "narrativeHook": { "type": "string" },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "intensitySource": { "enum": ["computed", "manual"] },
        "scoreReasons": { "type": "array", "items": { "type": "string" } },
        "characterRoles": {
          "type": "array",
          "items": { "enum": ["underdog", "favourite", "rival", "veteran", "rookie", "champion"] }
        },
        "lastReviewedAt": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
