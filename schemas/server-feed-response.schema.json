{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsport.vercel.app/schemas/server-feed-response.schema.json",
  "title": "nothingsport personalised server feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceVersion",
    "sourcePublishedAt",
    "events",
    "derivedCardCache",
    "pagination",
    "retention"
  ],
  "properties": {
    "schemaVersion": {
      "const": "server-feed.v2"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceVersion": {
      "type": "string"
    },
    "sourcePublishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "eventId", "date", "time"]
      }
    },
    "derivedCardCache": {
      "type": "object",
      "required": ["schemaVersion", "generatedAt", "buildOrigin", "derivedCards"],
      "properties": {
        "schemaVersion": {
          "const": "derived-card-cache.v1"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "buildOrigin": {
          "const": "server"
        },
        "sourceVersion": {
          "type": "string"
        },
        "derivedCards": {
          "type": "array"
        }
      }
    },
    "pagination": {
      "type": "object",
      "required": ["cursor", "limit", "nextCursor", "total"],
      "properties": {
        "cursor": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1 },
        "nextCursor": { "type": ["integer", "null"], "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "retention": {
      "type": "object",
      "required": [
        "archiveDays",
        "retentionDays",
        "inputEvents",
        "retainedEvents",
        "enrichedEvents",
        "derivedCards",
        "active",
        "archived",
        "saved",
        "expired"
      ]
    }
  }
}
