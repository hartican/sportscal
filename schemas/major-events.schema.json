{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsports.local/schemas/major-events.schema.json",
  "title": "nothingsport major events catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publishedAt", "events"],
  "properties": {
    "schemaVersion": { "const": "major-events.v1" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "checkedAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ticketing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "status", "url", "verifiedAt"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "status": { "enum": ["on_sale", "presale", "waitlist", "register_interest"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "saleStartAt": { "type": ["string", "null"], "format": "date-time" },
        "saleEndAt": { "type": ["string", "null"], "format": "date-time" },
        "inventoryStatus": { "enum": ["available", "selling_quickly", "limited", "sold_out"] },
        "inventoryVerifiedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "subEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "startTimeUtc", "venue", "stakesScore"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "sessionStartTimeUtc": { "type": ["string", "null"], "format": "date-time" },
        "sequenceInSession": { "type": "integer", "minimum": 0 },
        "previewPriority": { "type": "integer", "minimum": 0 },
        "timePrecision": { "enum": ["exact", "session-start", "follows", "date-only", "unpublished"] },
        "statusUpdatedAt": { "type": "string", "format": "date-time" },
        "resultPublishedAt": { "type": "string", "format": "date-time" },
        "stableMatchId": { "type": "string", "minLength": 1 },
        "legacyEventIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "cardKind": { "const": "fixture" },
        "name": { "type": "string", "minLength": 1 },
        "roundLabel": { "type": ["string", "null"] },
        "stage": { "type": ["string", "null"] },
        "matchType": { "type": ["string", "null"] },
        "court": { "type": ["string", "null"] },
        "scheduleStatus": { "enum": ["confirmed", "provisional", "tbc"] },
        "result": { "type": ["string", "object", "null"] },
        "matchupSides": { "type": "array" },
        "startTimeUtc": { "type": ["string", "null"], "format": "date-time" },
        "date": { "type": ["string", "null"], "format": "date" },
        "time": { "type": ["string", "null"] },
        "venue": { "type": "string", "minLength": 1 },
        "stakesScore": { "type": "integer", "minimum": 1, "maximum": 5 },
        "dateLabel": { "type": "string", "minLength": 1 },
        "expected": { "type": "number", "minimum": 0, "maximum": 10 },
        "status": { "enum": ["scheduled", "live", "completed", "postponed", "cancelled"] },
        "summary": { "type": "string" },
        "scoreDisplay": { "type": ["string", "null"] },
        "participants": { "type": "array" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "broadcaster": { "type": ["string", "null"] },
        "broadcasterIds": { "type": "array", "items": { "type": "string" } },
        "broadcastOptions": { "type": "array" },
        "viewingOptions": { "type": "array" },
        "competitionScope": { "enum": ["domestic", "international"] },
        "isInternational": { "type": "boolean" },
        "representativeCountryCodes": { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 3 } },
        "ticketing": { "$ref": "#/$defs/ticketing" }
        ,"sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "sportKey", "sportKeys", "sportLabel", "stakesScore", "dateStatus", "season", "summary", "details", "sources"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "eventFamilyId": { "type": "string", "minLength": 1 },
        "editionId": { "type": "string", "minLength": 1 },
        "phaseId": { "type": "string", "minLength": 1 },
        "phaseLabel": { "type": "string", "minLength": 1 },
        "phaseStartDate": { "type": ["string", "null"], "format": "date" },
        "phaseEndDate": { "type": ["string", "null"], "format": "date" },
        "kind": { "enum": ["tournament", "major_event", "ticket_sale"] },
        "parentEventId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "lifecycleStatus": { "enum": ["active", "retired"] },
        "retiredReason": { "type": "string", "minLength": 1 },
        "retiredAt": { "type": "string", "format": "date-time" },
        "retiredDeepLinkBehaviour": { "const": "safe-tombstone" },
        "phaseIdentity": { "enum": ["qualification", "league", "knockout", "finals", "main-draw"] },
        "sportKey": { "type": "string", "minLength": 1 },
        "sportKeys": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sportLabel": { "type": "string", "minLength": 1 },
        "competitionId": { "type": "string" },
        "competitionScope": { "enum": ["domestic", "international"] },
        "isInternational": { "type": "boolean" },
        "representativeCountryCodes": { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 3 } },
        "stakesScore": { "const": 5 },
        "dateStatus": { "enum": ["confirmed", "tbc"] },
        "season": { "type": "integer", "minimum": 2026 },
        "startDate": { "type": ["string", "null"], "format": "date" },
        "endDate": { "type": ["string", "null"], "format": "date" },
        "timezone": { "type": "string" },
        "venue": { "type": "string" },
        "location": { "type": "string" },
        "summary": { "type": "string", "minLength": 1 },
        "details": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "scheduleAdapter": { "type": "string" },
        "drawType": { "type": "string" },
        "draw": { "type": ["array", "object", "null"] },
        "participantIdentities": { "type": "array" },
        "currentPlayers": { "type": "array" },
        "broadcaster": { "type": ["string", "null"] },
        "broadcasterIds": { "type": "array", "items": { "type": "string" } },
        "broadcastOptions": { "type": "array" },
        "viewingOptions": { "type": "array" },
        "subEvents": { "type": "array", "items": { "$ref": "#/$defs/subEvent" } },
        "ticketing": { "$ref": "#/$defs/ticketing" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
      }
    }
  }
}
