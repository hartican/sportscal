{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsport.vercel.app/schemas/marquee-candidates.schema.json",
  "title": "Nothing Sport marquee campaign candidates",
  "type": "object",
  "required": ["schemaVersion", "sourceRevision", "generatedAt", "shadowMode", "summary", "candidates", "excluded"],
  "properties": {
    "schemaVersion": { "const": "marquee-candidates.v1" },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "shadowMode": { "const": true },
    "summary": {
      "type": "object",
      "required": ["stakesFiveFuture", "eligible", "actionable", "late"],
      "properties": {
        "stakesFiveFuture": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 },
        "actionable": { "type": "integer", "minimum": 0 },
        "late": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["campaignId", "campaignRevision", "contentHash", "state", "actionable", "late", "eventId", "proposedSendAt", "eligibilityEvidence", "timing", "source", "material", "drafts", "channels", "participation"],
        "properties": {
          "campaignId": { "type": "string", "pattern": "^marquee_[a-f0-9]{16}$" },
          "campaignRevision": { "const": 1 },
          "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "state": { "enum": ["watching", "draft", "needs_review", "approved", "exported", "scheduled", "connector_blocked", "partially_published", "published", "needs_reapproval", "failed", "cancelled"] },
          "actionable": { "type": "boolean" },
          "late": { "type": "boolean" },
          "eventId": { "type": "string", "minLength": 1 },
          "proposedSendAt": { "type": "string", "format": "date-time" },
          "eligibilityEvidence": { "type": "object" },
          "timing": { "type": "object" },
          "source": { "type": "object" },
          "material": { "type": "object" },
          "drafts": {
            "type": "object",
            "required": ["hook", "instagram", "email", "when", "finish"],
            "properties": {
              "email": {
                "type": "object",
                "required": ["subject", "preheader", "headline", "bodyParagraphs", "timingLine", "broadcastLine", "primaryCta", "secondaryCta", "image", "suggestedSendAt"],
                "properties": {
                  "subject": { "type": "string", "minLength": 1, "maxLength": 150 },
                  "preheader": { "type": "string", "minLength": 1, "maxLength": 150 },
                  "headline": { "type": "string", "minLength": 1, "maxLength": 240 },
                  "bodyParagraphs": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } },
                  "timingLine": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "broadcastLine": { "type": "string", "maxLength": 500 },
                  "primaryCta": { "$ref": "#/$defs/cta" },
                  "secondaryCta": { "$ref": "#/$defs/cta" },
                  "image": { "$ref": "#/$defs/image" },
                  "suggestedSendAt": { "$ref": "#/$defs/suggestedSendAt" }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "channels": { "type": "object" },
          "participation": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "excluded": { "type": "array" }
  },
  "$defs": {
    "cta": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": "string", "pattern": "^https://" }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": ["path", "publicUrl", "width", "height", "mimeType", "altText"],
      "properties": {
        "path": { "type": "string", "pattern": "^/assets/marquee/" },
        "publicUrl": { "type": "string", "pattern": "^https://" },
        "width": { "const": 1080 },
        "height": { "const": 1350 },
        "mimeType": { "const": "image/jpeg" },
        "altText": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "additionalProperties": true
    },
    "suggestedSendAt": {
      "type": "object",
      "required": ["utc", "sydney"],
      "properties": {
        "utc": { "type": "string", "format": "date-time" },
        "sydney": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
