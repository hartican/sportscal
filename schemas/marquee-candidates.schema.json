{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsport.vercel.app/schemas/marquee-candidates.schema.json",
  "title": "Nothing Sport marquee campaign candidates",
  "type": "object",
  "required": ["schemaVersion", "sourceRevision", "generatedAt", "shadowMode", "summary", "candidates", "excluded"],
  "properties": {
    "schemaVersion": { "const": "marquee-candidates.v1" },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "shadowMode": { "const": true },
    "summary": {
      "type": "object",
      "required": ["stakesFiveFuture", "shown", "eligible", "watching", "actionable", "late"],
      "properties": {
        "stakesFiveFuture": { "type": "integer", "minimum": 0 },
        "shown": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 },
        "watching": { "type": "integer", "minimum": 0 },
        "actionable": { "type": "integer", "minimum": 0 },
        "late": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["campaignId", "campaignRevision", "contentHash", "state", "actionable", "late", "eventId", "proposedSendAt", "readyForExport", "readinessIssues", "eligibilityEvidence", "timing", "source", "material", "drafts", "channels", "participation"],
        "properties": {
          "campaignId": { "type": "string", "pattern": "^marquee_[a-f0-9]{16}$" },
          "campaignRevision": { "const": 1 },
          "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "state": { "enum": ["watching", "draft", "needs_review", "approved", "exported", "scheduled", "connector_blocked", "partially_published", "published", "needs_reapproval", "failed", "cancelled"] },
          "actionable": { "type": "boolean" },
          "late": { "type": "boolean" },
          "eventId": { "type": "string", "minLength": 1 },
          "proposedSendAt": { "type": ["string", "null"], "format": "date-time" },
          "readyForExport": { "type": "boolean" },
          "readinessIssues": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "machineSort": {
            "type": "object",
            "required": ["proposedSendAt", "fixtureStartAt", "fixtureDate"],
            "properties": {
              "proposedSendAt": { "type": ["string", "null"], "format": "date-time" },
              "fixtureStartAt": { "type": ["string", "null"], "format": "date-time" },
              "fixtureDate": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "eligibilityEvidence": { "type": "object" },
          "timing": { "type": "object" },
          "source": { "type": "object" },
          "material": { "type": "object" },
          "assets": { "$ref": "#/$defs/assets" },
          "identities": { "$ref": "#/$defs/identities" },
          "live": { "$ref": "#/$defs/live" },
          "drafts": {
            "type": "object",
            "required": ["hook", "instagram", "email", "when", "finish"],
            "properties": {
              "email": {
                "type": "object",
                "required": ["subject", "preheader", "headline", "bodyParagraphs", "timingLine", "broadcastLine", "primaryCta", "secondaryCta", "image", "suggestedSendAt"],
                "properties": {
                  "subject": { "type": "string", "minLength": 1, "maxLength": 150 },
                  "preheader": { "type": "string", "minLength": 1, "maxLength": 150 },
                  "headline": { "type": "string", "minLength": 1, "maxLength": 240 },
                  "bodyParagraphs": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } },
                  "timingLine": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "broadcastLine": { "type": "string", "maxLength": 500 },
                  "primaryCta": { "$ref": "#/$defs/cta" },
                  "secondaryCta": { "$ref": "#/$defs/cta" },
                  "image": { "$ref": "#/$defs/image" },
                  "suggestedSendAt": { "$ref": "#/$defs/suggestedSendAt" }
                },
                "additionalProperties": true
              },
              "live": { "$ref": "#/$defs/live" }
            },
            "additionalProperties": true
          },
          "channels": { "type": "object" },
          "participation": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "excluded": { "type": "array" }
  },
  "$defs": {
    "cta": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": "string", "pattern": "^https://" }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": ["path", "publicUrl", "width", "height", "mimeType", "altText"],
      "properties": {
        "path": { "type": "string", "pattern": "^/assets/marquee/" },
        "publicUrl": { "type": "string", "pattern": "^https://" },
        "width": { "const": 1080 },
        "height": { "const": 1350 },
        "mimeType": { "const": "image/jpeg" },
        "altText": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "additionalProperties": true
    },
    "suggestedSendAt": {
      "type": "object",
      "required": ["utc", "sydney"],
      "properties": {
        "utc": { "type": ["string", "null"], "format": "date-time" },
        "sydney": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": ["fallbackHero", "suggestedHeroes", "uploadPolicy"],
      "properties": {
        "fallbackHero": { "$ref": "#/$defs/image" },
        "suggestedHeroes": { "type": "array", "items": { "$ref": "#/$defs/image" } },
        "uploadPolicy": { "const": "approved-media-only" }
      },
      "additionalProperties": true
    },
    "identityAsset": {
      "type": "object",
      "required": ["label", "path", "publicUrl", "provenance"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/assets/" },
        "publicUrl": { "type": "string", "pattern": "^https://" },
        "provenance": { "type": "object" }
      },
      "additionalProperties": true
    },
    "identities": {
      "type": "object",
      "required": ["code", "teams"],
      "properties": {
        "code": { "$ref": "#/$defs/identityAsset" },
        "teams": { "type": "array", "items": { "$ref": "#/$defs/identityAsset" } }
      },
      "additionalProperties": false
    },
    "live": {
      "type": "object",
      "required": ["headline", "hook", "kicker", "heroAssetId", "logos", "focalPosition", "animationPreset"],
      "properties": {
        "headline": { "type": "string", "minLength": 1, "maxLength": 240 },
        "hook": { "type": "string", "minLength": 1, "maxLength": 800 },
        "kicker": { "type": "string", "minLength": 1, "maxLength": 120 },
        "heroAssetId": { "type": "string" },
        "hero": { "$ref": "#/$defs/image" },
        "logos": { "type": "object" },
        "focalPosition": { "type": "object" },
        "animationPreset": { "enum": ["none", "subtle", "energy"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
