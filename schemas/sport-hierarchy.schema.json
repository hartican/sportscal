{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nothingsports.local/schemas/sport-hierarchy.schema.json",
  "title": "nothingsport canonical sport hierarchy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "levels", "nodes", "legacyIds", "legacySportKeys"],
  "properties": {
    "schemaVersion": { "const": "sport-hierarchy.v1" },
    "levels": {
      "const": ["sport", "discipline", "competition", "event_series"]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "legacyIds": { "$ref": "#/$defs/aliasMap" },
    "legacySportKeys": { "$ref": "#/$defs/aliasMap" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(sport|discipline|competition|event-series):[a-z0-9][a-z0-9:-]*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "level", "aliases", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 2 },
        "level": { "enum": ["sport", "discipline", "competition", "event_series"] },
        "parentId": { "$ref": "#/$defs/id" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "active": { "type": "boolean" }
      }
    },
    "aliasMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/id" }
    }
  }
}
