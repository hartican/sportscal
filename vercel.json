{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/notification-dispatch",
      "schedule": "* * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/sports_calendar.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
