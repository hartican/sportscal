{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/notification-dispatch",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/sports_calendar.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/live",
      "destination": "/participate.html"
    },
    {
      "source": "/fixture/:eventId",
      "destination": "/participate.html?eventId=:eventId"
    },
    {
      "source": "/admin/comms",
      "destination": "/admin-comms.html"
    }
  ]
}
