{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/notifications.js": {
      "includeFiles": "data/code-inspector/*.json",
      "maxDuration": 30
    },
    "api/notification-dispatch.js": {
      "includeFiles": "data/{code-inspector/*.json,comms-sources.v1.json,marquee-candidates.v1.json}",
      "maxDuration": 30
    },
    "api/comms.js": {
      "includeFiles": "data/{comms-sources.v1.json,marquee-candidates.v1.json,editorial-maintenance-sources.v1.json,editorial-post-match.v1.json}",
      "maxDuration": 60
    },
    "api/chat.js": {
      "includeFiles": "data/chat-fixtures.v1.json",
      "maxDuration": 60
    },
    "api/user-state.js": {
      "includeFiles": "data/{code-inspector/*.json,discovery/enrichment.v1.json,editorial-knowledge.v1.json,editorial-fixture-research.v1.json}"
    },
    "api/participation.js": {
      "maxDuration": 60,
      "includeFiles": "data/{code-inspector/*.json,nsc-forecasts.json}"
    },
    "api/feed.js": {
      "maxDuration": 60,
      "regions": ["syd1"],
      "includeFiles": "data/{code-inspector/*.json,discovery/enrichment.v1.json,events.json,follow-fixtures.v1.json,major-events.v1.json,editorial-knowledge.v1.json,editorial-fixture-research.v1.json}"
    },
    "api/dashboard-entry.js": { "maxDuration": 5, "regions": ["syd1"] },
    "api/dashboard.js": {
      "maxDuration": 10,
      "regions": ["syd1"]
    }
  },
  "redirects": [
    {
      "source": "/data/marquee-candidates.v1.json",
      "destination": "/api/comms?mode=internal-artifact",
      "permanent": false
    },
    {
      "source": "/data/comms-sources.v1.json",
      "destination": "/api/comms?mode=internal-artifact",
      "permanent": false
    },
    {
      "source": "/data/editorial-maintenance-sources.v1.json",
      "destination": "/api/comms?mode=internal-artifact",
      "permanent": false
    },
    { "source": "/data/editorial-post-match.v1.json", "destination": "/api/comms?mode=internal-artifact", "permanent": false },
    { "source": "/data/editorial-fixture-research.v1.json", "destination": "/api/comms?mode=internal-artifact", "permanent": false },
    { "source": "/data/editorial-knowledge.v1.json", "destination": "/api/comms?mode=internal-artifact", "permanent": false },
    {
      "source": "/sports_calendar.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/users",
      "permanent": false
    },
    {
      "source": "/admin-comms.html",
      "destination": "/admin/comms",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/admin/dashboard/view/overview", "destination": "/api/dashboard?route=overview" },
    { "source": "/api/admin/dashboard/view/delivery", "destination": "/api/dashboard?route=delivery" },
    { "source": "/api/admin/dashboard/view/queue", "destination": "/api/dashboard?route=queue" },
    { "source": "/api/admin/dashboard/view/evidence", "destination": "/api/dashboard?route=evidence" },
    {
      "source": "/admin/dashboard",
      "destination": "/api/dashboard-entry?route=overview"
    },
    {
      "source": "/admin/dashboard/delivery",
      "destination": "/api/dashboard-entry?route=delivery"
    },
    {
      "source": "/admin/dashboard/queue",
      "destination": "/api/dashboard-entry?route=queue"
    },
    {
      "source": "/admin/dashboard/evidence",
      "destination": "/api/dashboard-entry?route=evidence"
    },
    {
      "source": "/api/admin/dashboard",
      "destination": "/api/dashboard?route=data"
    },
    {
      "source": "/api/admin/dashboard/session",
      "destination": "/api/dashboard?route=session"
    },
    { "source": "/api/classics", "destination": "/api/user-state?route=classics" },
    { "source": "/admin/editorial", "destination": "/admin.html" },
    {
      "source": "/api/match-centre",
      "destination": "/api/feed?route=match-centre"
    },
    {
      "source": "/api/inbox",
      "destination": "/api/notifications?route=inbox"
    },
    {
      "source": "/api/fixtures",
      "destination": "/api/feed?route=fixtures"
    },
    {
      "source": "/api/fixture-refresh",
      "destination": "/api/feed?route=fixture-refresh"
    },
    {
      "source": "/api/calendar",
      "destination": "/api/user-state?route=calendar"
    },
    {
      "source": "/api/nothingscore",
      "destination": "/api/participation?mode=nothingscore"
    },
    {
      "source": "/api/nothingscore-marquee",
      "destination": "/api/participation?mode=nothingscore-marquee"
    },
    {
      "source": "/api/admin/users",
      "destination": "/api/comms?mode=admin-users"
    },
    {
      "source": "/api/admin/reports",
      "destination": "/api/comms?mode=admin-reports"
    },
    {
      "source": "/api/admin/panel",
      "destination": "/api/comms?mode=admin-panel"
    },
    {
      "source": "/live",
      "destination": "/participate.html"
    },
    {
      "source": "/fixture/:eventId",
      "destination": "/participate.html?eventId=:eventId"
    },
    {
      "source": "/admin/users",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/reports",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/comms",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/app-version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
